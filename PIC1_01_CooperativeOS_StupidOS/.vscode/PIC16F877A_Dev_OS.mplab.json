{
    "version": "1.9",
    "configurations": [
        {
            "name": "default",
            "id": "",
            "device": "PIC16F877A",
            "imagePath": "./out/PIC16F877A_Dev_OS/default.elf",
            "toolProperties": "default-tool-base",
            "tool": "PICkit 4",
            "packs": [
                {
                    "name": "PIC16Fxxx_DFP",
                    "vendor": "Microchip",
                    "version": "1.8.167"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC8"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-uservariables",
            "type": "uservariables",
            "properties": {}
        },
        {
            "name": "default-XC8",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-COMP.optimization-level": "-O0",
                "HI-TECH-COMP.warning-level": "0"
            }
        },
        {
            "name": "default-tool-base",
            "type": "tool",
            "properties": {
                "poweroptions.powerenable": true,
                "voltagevalue": "5",
                "Freeze Peripherals": true
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/@(build|_build|out|cmake|.vscode)/**/*"
                }
            ]
        }
    ]
}
